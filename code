<style>
  :root{
    --bg:#FDFDFC;
    --panel:#FFFFFF;
    --ink:#262421;
    --ink-soft:#5B5650;
    --ink-faint:#8C877E;
    --line:#E8E4DD;
    --line-soft:#F1EEE8;
    --cardinal:#8C1515;
    --cardinal-deep:#5E0E0E;
    --exp-low:#E3DFD8;
    --exp-mid:#C98A6E;
    --focus:#2B6CB0;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'Inter',-apple-system,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1320px;margin:0 auto;padding:36px 28px 60px;}

  /* ---------- header ---------- */
  header{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px;
    padding-bottom:22px;border-bottom:1px solid var(--line);margin-bottom:22px;}
  .eyebrow{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--cardinal);font-weight:600;margin-bottom:10px;}
  h1{font-family:'Source Serif 4',serif;font-weight:600;font-size:34px;line-height:1.12;margin:0 0 10px;
    letter-spacing:-.01em;max-width:640px;}
  .sub{color:var(--ink-soft);font-size:14.5px;line-height:1.55;max-width:520px;}
  .credit{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--ink-faint);text-align:right;
    line-height:1.7;max-width:280px;}
  .credit a{color:var(--ink-soft);text-decoration:none;border-bottom:1px solid var(--line);}
  .credit a:hover{color:var(--cardinal);border-color:var(--cardinal);}

  /* ---------- stats bar ---------- */
  .stats{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);
    border:1px solid var(--line);border-radius:10px;overflow:hidden;margin-bottom:22px;}
  .stat{background:var(--panel);padding:16px 18px;}
  .stat .n{font-family:'IBM Plex Mono',monospace;font-size:22px;font-weight:600;color:var(--ink);letter-spacing:-.02em;}
  .stat .n small{font-size:13px;font-weight:500;color:var(--ink-faint);}
  .stat .l{font-size:11px;color:var(--ink-faint);margin-top:4px;text-transform:uppercase;letter-spacing:.06em;}
  .stat.accent .n{color:var(--cardinal);}

  /* ---------- controls ---------- */
  .controls{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-bottom:16px;
    padding:14px 16px;background:var(--panel);border:1px solid var(--line);border-radius:10px;}
  .search{position:relative;flex:1 1 220px;min-width:180px;}
  .search input{width:100%;padding:8px 12px 8px 30px;border:1px solid var(--line);border-radius:7px;
    font-family:'Inter';font-size:13px;color:var(--ink);background:var(--bg);}
  .search input:focus{outline:2px solid var(--focus);outline-offset:1px;}
  .search::before{content:'';position:absolute;left:10px;top:50%;transform:translateY(-50%);
    width:12px;height:12px;border:1.5px solid var(--ink-faint);border-radius:50%;}
  .search::after{content:'';position:absolute;left:19px;top:63%;width:6px;height:1.5px;background:var(--ink-faint);
    transform:rotate(45deg);}

  .seg{display:flex;border:1px solid var(--line);border-radius:7px;overflow:hidden;font-family:'IBM Plex Mono',monospace;}
  .seg button{border:none;background:var(--panel);padding:7px 12px;font-size:11.5px;color:var(--ink-soft);
    cursor:pointer;letter-spacing:.02em;border-right:1px solid var(--line);}
  .seg button:last-child{border-right:none;}
  .seg button.active{background:var(--ink);color:#fff;}

  .range-group{display:flex;align-items:center;gap:8px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--ink-faint);}
  .range-group input[type=range]{width:110px;accent-color:var(--cardinal);}
  .range-group .val{color:var(--ink);min-width:16px;text-align:center;font-weight:600;}

  select.catfilter{border:1px solid var(--line);border-radius:7px;background:var(--panel);padding:7px 10px;
    font-family:'Inter';font-size:12.5px;color:var(--ink-soft);}

  .reset{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--ink-faint);background:none;border:none;
    text-decoration:underline;cursor:pointer;padding:0;}
  .reset:hover{color:var(--cardinal);}

  /* ---------- legend ---------- */
  .legend-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:16px;flex-wrap:wrap;}
  .exp-legend{display:flex;align-items:center;gap:8px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--ink-faint);}
  .exp-gradient{width:160px;height:8px;border-radius:4px;background:linear-gradient(90deg,var(--exp-low),var(--exp-mid),var(--cardinal));}
  .cat-legend{display:flex;flex-wrap:wrap;gap:10px;font-size:10.5px;color:var(--ink-soft);}
  .cat-legend span{display:inline-flex;align-items:center;gap:5px;}
  .cat-legend i{width:9px;height:9px;border-radius:2px;display:inline-block;}

  /* ---------- treemap ---------- */
  .chart-shell{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:6px;}
  #chart{display:block;width:100%;height:auto;}
  .grp-label{font-family:'IBM Plex Mono',monospace;font-size:10.5px;font-weight:600;fill:var(--ink-soft);
    letter-spacing:.03em;text-transform:uppercase;pointer-events:none;}
  .grp-count{font-family:'IBM Plex Mono',monospace;font-size:9.5px;fill:var(--ink-faint);pointer-events:none;}
  .grp-momentum{font-family:'IBM Plex Mono',monospace;font-size:9.5px;font-weight:600;pointer-events:none;}
  .mom-up{fill:#5C7A5E;}
  .mom-down{fill:var(--cardinal);}
  .data-note{background:var(--line-soft);border:1px solid var(--line);border-radius:9px;padding:12px 14px;
    font-size:12px;color:var(--ink-soft);line-height:1.55;margin-bottom:16px;}
  .data-note b{color:var(--ink);}
  .data-note .src{color:var(--ink-faint);font-family:'IBM Plex Mono',monospace;font-size:10.5px;}
  .leaf-rect{stroke:var(--panel);stroke-width:1.4px;cursor:pointer;transition:opacity .15s ease;}
  .leaf-rect.dim{opacity:.16;}
  .leaf-rect.search-match{stroke:var(--cardinal);stroke-width:2px;}
  .leaf-rect.cited{stroke-width:2px;stroke:#3C6E4A;}
  .cite-dot{fill:#3C6E4A;pointer-events:none;}
  .prov-cited{color:#3C6E4A;font-weight:600;}
  .prov-rubric{color:var(--ink-faint);}
  .leaf-label{font-family:'Inter';font-weight:600;pointer-events:none;fill:#fff;}
  .leaf-sub{font-family:'IBM Plex Mono',monospace;pointer-events:none;fill:rgba(255,255,255,.82);}
  .leaf-label.dark, .leaf-sub.dark{fill:var(--ink);}
  .leaf-sub.dark{fill:var(--ink-soft);}

  /* ---------- tooltip ---------- */
  #tooltip{position:fixed;pointer-events:none;background:var(--ink);color:#fff;padding:11px 13px;border-radius:8px;
    font-size:12.5px;max-width:260px;box-shadow:0 8px 24px rgba(0,0,0,.18);opacity:0;transition:opacity .1s ease;z-index:50;}
  #tooltip .t-name{font-weight:600;font-size:13.5px;margin-bottom:3px;}
  #tooltip .t-cat{font-family:'IBM Plex Mono',monospace;font-size:10px;color:#C9A9A0;text-transform:uppercase;
    letter-spacing:.05em;margin-bottom:7px;}
  #tooltip .t-row{display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:11px;
    color:rgba(255,255,255,.8);margin-bottom:2px;}
  #tooltip .t-row b{color:#fff;}
  #tooltip .t-note{margin-top:7px;padding-top:7px;border-top:1px solid rgba(255,255,255,.15);
    color:rgba(255,255,255,.85);line-height:1.4;font-size:11.5px;}

  /* ---------- detail panel ---------- */
  #detail{display:none;margin-top:16px;background:var(--panel);border:1px solid var(--line);border-radius:12px;
    padding:20px 22px;}
  #detail.open{display:flex;gap:26px;flex-wrap:wrap;}
  #detail .d-main{flex:1 1 300px;}
  #detail .d-cat{font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--cardinal);
    text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;}
  #detail h3{font-family:'Source Serif 4',serif;font-size:22px;margin:0 0 8px;font-weight:600;}
  #detail p{margin:0;color:var(--ink-soft);font-size:13.5px;line-height:1.55;max-width:440px;}
  #detail .d-metrics{flex:0 0 220px;display:flex;flex-direction:column;gap:12px;}
  .metric-block .m-label{font-size:10.5px;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;}
  .metric-block .m-value{font-family:'IBM Plex Mono',monospace;font-size:19px;font-weight:600;}
  .m-bar-track{height:6px;background:var(--line-soft);border-radius:3px;margin-top:6px;overflow:hidden;}
  .m-bar-fill{height:100%;background:var(--cardinal);border-radius:3px;}
  #detail .close-x{position:absolute;top:14px;right:16px;background:none;border:none;color:var(--ink-faint);
    font-size:18px;cursor:pointer;line-height:1;}
  #detail{position:relative;}

  /* ---------- footer ---------- */
  footer{margin-top:26px;padding-top:18px;border-top:1px solid var(--line);color:var(--ink-faint);
    font-size:11.5px;line-height:1.7;}
  footer b{color:var(--ink-soft);}

  @media (max-width:800px){
    .stats{grid-template-columns:repeat(2,1fr);}
    header{flex-direction:column;align-items:flex-start;}
    .credit{text-align:left;}
  }
</style>
</head>
